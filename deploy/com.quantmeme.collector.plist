<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.quantmeme.collector</string>

  <!-- Point-in-time Solana pool collector: snapshots + token fields + candles. -->
  <key>ProgramArguments</key>
  <array>
    <string>/Volumes/DEXP W500C/quant-memcoins-researcher/.venv/bin/python</string>
    <string>-m</string>
    <string>ai_quant_lab.meme</string>
    <string>run</string>
    <string>--db</string>
    <string>data/meme.db</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Volumes/DEXP W500C/quant-memcoins-researcher</string>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <!-- If the external disk is not mounted the job fails fast; retry slowly. -->
  <key>ThrottleInterval</key>
  <integer>60</integer>

  <key>StandardOutPath</key>
  <string>/Volumes/DEXP W500C/quant-memcoins-researcher/data/collector.log</string>
  <key>StandardErrorPath</key>
  <string>/Volumes/DEXP W500C/quant-memcoins-researcher/data/collector.log</string>
</dict>
</plist>
